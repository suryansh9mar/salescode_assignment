# LiveKit Server Configuration
# Get these from: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret



# Deepgram API Key (for Speech-to-Text)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-key

# Cartesia API Key (for TTS)
# Get from: https://cartesia.ai/
CARTESIA_API_KEY=your-cartesia-key

# Google API Key (for Gemini)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-key


# Intelligent Interruption Handler Configuration
# Comma-separated list of filler words to ignore when agent is speaking
# These words will be filtered out to prevent unwanted interruptions
FILLER_WORDS=uh,umm,hmm,haan,um,er,ah

